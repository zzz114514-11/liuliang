{
  "_comment": "异常检测规则配置文件。可直接修改本文件调整阈值，无需改动代码。",
  "version": "1.0",

  "high_frequency_ip": {
    "enabled": true,
    "name": "单IP高频访问",
    "description": "单个IP在统计窗口内请求数超过阈值，疑似扫描器或暴力破解",
    "threshold": 300,
    "min_error_rate": 0.0,
    "severity": "high",
    "top_n": 10
  },

  "burst_ip": {
    "enabled": true,
    "name": "单IP短时间突发访问",
    "description": "单个IP在极短时间内（默认60秒）发起大量请求，典型的自动化扫描特征",
    "window_seconds": 60,
    "threshold": 60,
    "severity": "high",
    "top_n": 10
  },

  "error_rate": {
    "enabled": true,
    "name": "4xx/5xx错误率异常",
    "description": "整体错误率或单IP错误率超过阈值，可能因攻击、爬虫或服务端故障导致",
    "global_4xx_threshold": 15.0,
    "global_5xx_threshold": 5.0,
    "per_ip_error_rate": 50.0,
    "per_ip_min_requests": 50,
    "severity": "medium",
    "top_n": 10
  },

  "suspicious_user_agent": {
    "enabled": true,
    "name": "可疑User-Agent",
    "description": "命中已知扫描器/自动化工具/空UA等特征",
    "severity": "medium",
    "allow_empty": false,
    "patterns": [
      "sqlmap",
      "nikto",
      "nmap",
      "nessus",
      "awvs",
      "acunetix",
      "wpscan",
      "dirbuster",
      "gobuster",
      "masscan",
      "zgrab",
      "hydra",
      "burpcollaborator",
      "python-requests",
      "python-urllib",
      "go-http-client",
      "curl/",
      "wget/",
      "scrapy",
      "httpclient",
      "libwww-perl",
      "mechanize",
      "httrack",
      "zmeu",
      "morfeus",
      "zollard",
      "wordpress scanner",
      "jorgee",
      "l9explore",
      "netcraftsurvey",
      "^-$"
    ]
  },

  "attack_signature": {
    "enabled": true,
    "name": "疑似攻击特征请求",
    "description": "URL或请求中命中已知攻击特征（路径遍历、SQL注入、XSS、命令注入等）",
    "severity": "critical",
    "scan_fields": ["path", "referer", "agent"],
    "rules": [
      {
        "id": "LFI-001",
        "type": "路径遍历 / 本地文件包含",
        "pattern": "(\\.\\./|\\.\\.\\\\|%2e%2e%2f|%252e%252e|\\.\\.%2f|\\.\\.%5c)",
        "severity": "critical",
        "description": "尝试通过 ../ 穿越目录读取敏感文件，如 ../../etc/passwd"
      },
      {
        "id": "LFI-002",
        "type": "敏感文件探测",
        "pattern": "(?i)(/etc/(passwd|shadow|hosts)|/proc/self/environ|boot\\.ini|win\\.ini|\\.env|\\.git/config|wp-config\\.php|/\\.aws/credentials|id_rsa)",
        "severity": "critical",
        "description": "直接请求系统或配置敏感文件"
      },
      {
        "id": "SQLI-001",
        "type": "SQL注入 - 联合查询",
        "pattern": "(?i)(union\\s+(all\\s+)?select|select\\s+.*\\s+from\\s+information_schema)",
        "severity": "critical",
        "description": "使用 UNION SELECT 拖库或探测 information_schema"
      },
      {
        "id": "SQLI-002",
        "type": "SQL注入 - 布尔/报错注入",
        "pattern": "(?i)(\\b(or|and)\\b\\s+\\d+\\s*=\\s*\\d+|'\\s+or\\s+'|\\\"\\s+or\\s+\\\"|sleep\\s*\\(|benchmark\\s*\\(|extractvalue\\s*\\(|updatexml\\s*\\(|waitfor\\s+delay)",
        "severity": "critical",
        "description": "布尔盲注、时间盲注与报错注入常见载荷"
      },
      {
        "id": "SQLI-003",
        "type": "SQL注入 - 注释与堆叠",
        "pattern": "(--\\s|#\\s|;/\\*|%27|%23|char\\s*\\(\\s*\\d|xp_cmdshell)",
        "severity": "high",
        "description": "SQL注释符、十六进制编码与存储过程调用"
      },
      {
        "id": "XSS-001",
        "type": "跨站脚本 XSS",
        "pattern": "(?i)(<script|%3cscript|javascript:|onerror\\s*=|onload\\s*=|alert\\s*\\(|<img\\s+src\\s*=|document\\.cookie)",
        "severity": "high",
        "description": "在URL中注入脚本标签或事件处理器"
      },
      {
        "id": "CMDI-001",
        "type": "命令注入",
        "pattern": "(\\;\\s*(cat|ls|id|whoami|uname|wget|curl|nc|bash|sh|chmod|rm)\\s|\\|\\s*(cat|ls|id|whoami)\\s|\\$\\(|`.*`|&&\\s*(cat|ls|id))",
        "severity": "critical",
        "description": "通过管道或分号拼接系统命令"
      },
      {
        "id": "RCE-001",
        "type": "WebShell / 后门访问",
        "pattern": "(?i)(/shell\\.|c99\\.php|r57\\.php|/cmd\\.php|/backdoor|/webshell|eval\\s*\\(|base64_decode\\s*\\(|system\\s*\\(|assert\\s*\\()",
        "severity": "critical",
        "description": "访问或调用已知WebShell文件与危险函数"
      },
      {
        "id": "SCAN-001",
        "type": "后台/管理入口探测",
        "pattern": "(?i)(/admin|/phpmyadmin|/manager/html|/solr/admin|/console|/wp-login\\.php|/xmlrpc\\.php|/actuator|/swagger-ui|/druid/index\\.html|/\\.git/|/\\.svn/|/backup/|/db\\.sql|/\\.DS_Store)",
        "severity": "medium",
        "description": "批量扫描常见后台入口、运维端点与备份文件"
      },
      {
        "id": "SSRF-001",
        "type": "SSRF / 内网探测",
        "pattern": "(?i)((?<![\\d.])(127\\.0\\.0\\.1|0\\.0\\.0\\.0|169\\.254\\.169\\.254|10\\.\\d+\\.\\d+\\.\\d+|192\\.168\\.\\d+\\.\\d+|172\\.(1[6-9]|2\\d|3[01])\\.(?:\\d{1,3}\\.){1}\\d{1,3})(?![\\d.])|\\blocalhost\\b|file://|gopher://|dict://|php://|data://)",
        "severity": "high",
        "description": "请求内网地址或危险协议，可能为SSRF探测",
        "scan_fields": ["path", "referer"],
        "note": "增加 (?<![\\d.]) 边界断言，避免 Chrome/120.0.0.0 这类版本号被误判为内网IP"
      },
      {
        "id": "LOG4J-001",
        "type": "Log4Shell JNDI注入",
        "pattern": "(?i)(\\$\\{jndi:|\\$\\{\\$\\{|%24%7bjndi)",
        "severity": "critical",
        "description": "Log4j2 远程代码执行漏洞利用特征"
      },
      {
        "id": "TRAV-001",
        "type": "编码绕过探测",
        "pattern": "(?i)(%00|\\0|\\.\\.\\x00|%%32%65|%c0%ae|%uff1e|\\.\\.\\%c0\\%af)",
        "severity": "high",
        "description": "使用空字节、超长UTF-8等编码方式绕过防护"
      }
    ]
  },

  "http_abnormal": {
    "enabled": true,
    "name": "异常HTTP方法/协议",
    "description": "非常规请求方法（PUT/DELETE/TRACE/CONNECT等），常被用于探测服务端能力",
    "severity": "medium",
    "allowed_methods": ["GET", "POST", "HEAD"],
    "top_n": 10
  }
}
